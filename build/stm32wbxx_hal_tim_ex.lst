 146:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c **** /** @defgroup TIMEx_Exported_Functions_Group1 Extended Timer Hall Sensor functions
 147:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   * @brief    Timer Hall Sensor functions
 148:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   *
 149:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c **** @verbatim
 150:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   ==============================================================================
 151:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****                       ##### Timer Hall Sensor functions #####
 152:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   ==============================================================================
 153:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   [..]
 154:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****     This section provides functions allowing to:
 155:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****     (+) Initialize and configure TIM HAL Sensor.
 156:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****     (+) De-initialize TIM HAL Sensor.
 157:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****     (+) Start the Hall Sensor Interface.
 158:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****     (+) Stop the Hall Sensor Interface.
 159:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****     (+) Start the Hall Sensor Interface and enable interrupts.
 160:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****     (+) Stop the Hall Sensor Interface and disable interrupts.
 161:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****     (+) Start the Hall Sensor Interface and enable DMA transfers.
 162:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****     (+) Stop the Hall Sensor Interface and disable DMA transfers.
 163:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c **** 
 164:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c **** @endverbatim
 165:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   * @{
 166:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   */
 167:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c **** /**
 168:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   * @brief  Initializes the TIM Hall Sensor Interface and initialize the associated handle.
 169:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   * @note   When the timer instance is initialized in Hall Sensor Interface mode,
 170:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   *         timer channels 1 and channel 2 are reserved and cannot be used for
 171:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   *         other purpose.
 172:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   * @param  htim TIM Hall Sensor Interface handle
 173:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim_ex.c ****   * @param  sConfig TIM Hall Sensor configuration structure
