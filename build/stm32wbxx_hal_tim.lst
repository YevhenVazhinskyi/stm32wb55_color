2959:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c **** HAL_StatusTypeDef HAL_TIM_OnePulse_Stop_IT(TIM_HandleTypeDef *htim, uint32_t OutputChannel)
2960:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c **** {
2961:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   /* Prevent unused argument(s) compilation warning */
2962:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   UNUSED(OutputChannel);
