2969:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c **** 
2970:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   /* Disable the Capture compare and the Input Capture channels
2971:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   (in the OPM Mode the two possible channels that can be used are TIM_CHANNEL_1 and TIM_CHANNEL_2)
