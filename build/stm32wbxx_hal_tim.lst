7814:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   * @brief  Configures the TIMx External Trigger (ETR).
7815:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   * @param  TIMx to select the TIM peripheral
7816:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   * @param  TIM_ExtTRGPrescaler The external Trigger Prescaler.
7817:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   *          This parameter can be one of the following values:
7818:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV1: ETRP Prescaler OFF.
7819:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV2: ETRP frequency divided by 2.
7820:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV4: ETRP frequency divided by 4.
7821:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   *            @arg TIM_ETRPRESCALER_DIV8: ETRP frequency divided by 8.
7822:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   * @param  TIM_ExtTRGPolarity The external Trigger Polarity.
7823:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   *          This parameter can be one of the following values:
7824:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   *            @arg TIM_ETRPOLARITY_INVERTED: active low or falling edge active.
7825:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   *            @arg TIM_ETRPOLARITY_NONINVERTED: active high or rising edge active.
7826:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   * @param  ExtTRGFilter External Trigger Filter.
7827:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   *          This parameter must be a value between 0x00 and 0x0F
7828:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   * @retval None
7829:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_tim.c ****   */
