3767:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c **** static void UART_DMATransmitCplt(DMA_HandleTypeDef *hdma)
3768:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c **** {
3769:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****   UART_HandleTypeDef *huart = (UART_HandleTypeDef *)(hdma->Parent);
3770:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c **** 
3771:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****   /* DMA Normal mode */
3772:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****   if (HAL_IS_BIT_CLR(hdma->Instance->CCR, DMA_CCR_CIRC))
3773:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****   {
3774:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****     huart->TxXferCount = 0U;
3775:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c **** 
3776:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****     /* Disable the DMA transfer for transmit request by resetting the DMAT bit
3777:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****        in the UART CR3 register */
3778:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****     ATOMIC_CLEAR_BIT(huart->Instance->CR3, USART_CR3_DMAT);
3779:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c **** 
3780:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****     /* Enable the UART Transmit Complete Interrupt */
3781:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****     ATOMIC_SET_BIT(huart->Instance->CR1, USART_CR1_TCIE);
3782:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****   }
3783:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****   /* DMA Circular mode */
3784:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****   else
3785:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****   {
3786:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c **** #if (USE_HAL_UART_REGISTER_CALLBACKS == 1)
3787:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****     /*Call registered Tx complete callback*/
3788:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****     huart->TxCpltCallback(huart);
3789:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c **** #else
3790:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****     /*Call legacy weak Tx complete callback*/
3791:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****     HAL_UART_TxCpltCallback(huart);
3792:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c **** #endif /* USE_HAL_UART_REGISTER_CALLBACKS */
3793:Drivers/STM32WBxx_HAL_Driver/Src/stm32wbxx_hal_uart.c ****   }
